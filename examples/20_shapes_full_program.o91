class Shape is
    method Area : Integer is
        return Integer(0)
    end
end

class Square extends Shape is
    var side : Integer(0)

    this(s: Integer) is
        side := s
    end

    method Area : Integer is
        return side.Mult(side)
    end
end

class Rectangle extends Shape is
    var width : Integer(0)
    var height : Integer(0)

    this(w: Integer, h: Integer) is
        width := w
        height := h
    end

    method Area : Integer is
        return width.Mult(height)
    end
end

class AreaSummer is
    var total : Integer(0)

    method Add(s: Shape) is
        total := total.Plus(s.Area())
    end

    method Total : Integer is
        return total
    end
end

class Main is
    this() is
        var summer : AreaSummer()
        var s : Shape()

        s := Square(Integer(4))
        summer.Add(s)
        summer.Add(Rectangle(Integer(3), Integer(5)))

        summer.Total().Print()
    end
end
